{
 "note": "Scénarios de la porte de requêtes (RequestGate), lus par les DEUX suites. Horloge simulée en secondes ; aléa fixé à 0,5 ; titlesBeforeBreaker 1 et espacement 0,3 s par défaut. Ops : beginTitle(now?), beginAttempt(limit), offline(value), admit(now)→expect, start(now), finish(now, outcome, fallback?)→verdict attendu, state→champs attendus. Comparaison à 1e-9 près.",
 "random": 0.5,
 "scenarios": [
  {"name": "succès puis espacement de 300 ms", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "admit", "now": 0.1, "expect": {"kind": "busy"}},
   {"op": "finish", "now": 0.2, "outcome": {"kind": "success"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 0.2, "expect": {"kind": "wait", "seconds": 0.3}},
   {"op": "admit", "now": 0.5, "expect": {"kind": "proceed", "timeout": 8}}
  ]},
  {"name": "espacement imposé de 1,05 s (commande de contrôle)", "gate": {"minSpacing": 1.05}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0.1, "outcome": {"kind": "success"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 0.2, "expect": {"kind": "wait", "seconds": 0.95}},
   {"op": "admit", "now": 1.15, "expect": {"kind": "proceed", "timeout": 8}}
  ]},
  {"name": "429 avec Retry-After 20 : porte fermée 20,5 s, puis un second 429 abandonne", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0.1, "outcome": {"kind": "rateLimited", "retryAfter": 20}, "expect": {"kind": "retry", "after": 20.5}},
   {"op": "admit", "now": 5, "expect": {"kind": "closed", "until": 20.6, "reason": "rateLimited"}},
   {"op": "admit", "now": 20.6, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 20.6},
   {"op": "finish", "now": 20.7, "outcome": {"kind": "rateLimited", "retryAfter": 20}, "expect": {"kind": "giveUp", "reason": "rateLimitedAgain"}},
   {"op": "state", "expect": {"breakerTrips": 2, "closedUntil": 41.2, "closedReason": "rateLimited"}}
  ]},
  {"name": "429 : Retry-After de 86400 plafonné à 300 s", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0, "outcome": {"kind": "rateLimited", "retryAfter": 86400}, "expect": {"kind": "retry", "after": 300.5}},
   {"op": "state", "expect": {"closedUntil": 300.5, "closedReason": "rateLimited"}}
  ]},
  {"name": "429 sans Retry-After : 30 s par défaut", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0, "outcome": {"kind": "rateLimited"}, "expect": {"kind": "retry", "after": 30.5}},
   {"op": "state", "expect": {"closedUntil": 30.5}}
  ]},
  {"name": "429 : Retry-After négatif ramené à 0 (aléa seul)", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0, "outcome": {"kind": "rateLimited", "retryAfter": -5}, "expect": {"kind": "retry", "after": 0.5}}
  ]},
  {"name": "429 : un nouveau titre ne rouvre pas la porte", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0.1, "outcome": {"kind": "rateLimited", "retryAfter": 20}, "expect": {"kind": "retry", "after": 20.5}},
   {"op": "beginTitle", "now": 1},
   {"op": "admit", "now": 1, "expect": {"kind": "closed", "until": 20.6, "reason": "rateLimited"}}
  ]},
  {"name": "503 avec une autre voie (get puis search) : on passe tout de suite, porte ouverte", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0.2, "outcome": {"kind": "serverError", "status": 503, "retryAfter": 1}, "expect": {"kind": "proceed"}, "fallback": true},
   {"op": "admit", "now": 0.2, "expect": {"kind": "wait", "seconds": 0.3}},
   {"op": "admit", "now": 0.5, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "state", "expect": {"closedUntil": null, "breakerTrips": 0, "consecutiveFailures": 1}}
  ]},
  {"name": "503 sans autre voie : un nouvel essai après Retry-After, puis disjoncteur de 10 s", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0.1, "outcome": {"kind": "serverError", "status": 503, "retryAfter": 1}, "expect": {"kind": "retry", "after": 1}},
   {"op": "admit", "now": 0.5, "expect": {"kind": "wait", "seconds": 0.6}},
   {"op": "admit", "now": 1.1, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 1.1},
   {"op": "finish", "now": 1.2, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "giveUp", "reason": "serverErrors"}},
   {"op": "admit", "now": 2, "expect": {"kind": "closed", "until": 11.2, "reason": "breaker"}},
   {"op": "state", "expect": {"breakerTrips": 1}}
  ]},
  {"name": "503 : Retry-After de 99999 plafonné à 300 s", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0, "outcome": {"kind": "serverError", "status": 503, "retryAfter": 99999}, "expect": {"kind": "retry", "after": 300}}
  ]},
  {"name": "délai dépassé sans autre voie : 2 s + aléa", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 8, "outcome": {"kind": "timeout"}, "expect": {"kind": "retry", "after": 2.5}}
  ]},
  {"name": "panne réseau sans autre voie : 2 s + aléa", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0.1, "outcome": {"kind": "transportFailure"}, "expect": {"kind": "retry", "after": 2.5}}
  ]},
  {"name": "disjoncteur 10, 20 s ; un nouveau titre ramène la pause à 5 s ; un succès remet à zéro", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "retry", "after": 2.5}},
   {"op": "admit", "now": 2.5, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 2.5},
   {"op": "finish", "now": 2.5, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "giveUp", "reason": "serverErrors"}},
   {"op": "state", "expect": {"breakerTrips": 1, "closedUntil": 12.5, "closedReason": "breaker"}},
   {"op": "beginTitle", "now": 3},
   {"op": "admit", "now": 3, "expect": {"kind": "closed", "until": 8, "reason": "breaker"}},
   {"op": "admit", "now": 8, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 8},
   {"op": "finish", "now": 8, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "giveUp", "reason": "serverErrors"}},
   {"op": "state", "expect": {"breakerTrips": 2, "closedUntil": 28}},
   {"op": "beginTitle", "now": 28},
   {"op": "admit", "now": 28, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 28},
   {"op": "finish", "now": 28.1, "outcome": {"kind": "success"}, "expect": {"kind": "proceed"}},
   {"op": "state", "expect": {"breakerTrips": 0, "closedUntil": null, "closedReason": null, "consecutiveFailures": 0}}
  ]},
  {"name": "trois titres différents en échec avant le disjoncteur (titlesBeforeBreaker 3)", "gate": {"titlesBeforeBreaker": 3}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "retry", "after": 2.5}},
   {"op": "admit", "now": 2.5, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 2.5},
   {"op": "finish", "now": 2.5, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "retry", "after": 2.5}},
   {"op": "admit", "now": 5, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 5},
   {"op": "finish", "now": 5, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "giveUp", "reason": "serverErrors"}},
   {"op": "state", "expect": {"failedTitlesInARow": 1, "closedUntil": null, "breakerTrips": 0}},
   {"op": "beginTitle"},
   {"op": "admit", "now": 10, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 10},
   {"op": "finish", "now": 10, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "retry", "after": 2.5}},
   {"op": "admit", "now": 12.5, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 12.5},
   {"op": "finish", "now": 12.5, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "retry", "after": 2.5}},
   {"op": "admit", "now": 15, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 15},
   {"op": "finish", "now": 15, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "giveUp", "reason": "serverErrors"}},
   {"op": "state", "expect": {"failedTitlesInARow": 2, "closedUntil": null, "breakerTrips": 0}},
   {"op": "beginTitle"},
   {"op": "admit", "now": 20, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 20},
   {"op": "finish", "now": 20, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "retry", "after": 2.5}},
   {"op": "admit", "now": 22.5, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 22.5},
   {"op": "finish", "now": 22.5, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "retry", "after": 2.5}},
   {"op": "admit", "now": 25, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 25},
   {"op": "finish", "now": 25, "outcome": {"kind": "serverError", "status": 503}, "expect": {"kind": "giveUp", "reason": "serverErrors"}},
   {"op": "state", "expect": {"failedTitlesInARow": 3, "closedUntil": 35, "closedReason": "breaker", "breakerTrips": 1}}
  ]},
  {"name": "budget de 15 s consommé par la lenteur sans erreur", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 7, "outcome": {"kind": "success"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 7.3, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 7.3},
   {"op": "finish", "now": 14.3, "outcome": {"kind": "notFound"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 14.6, "expect": {"kind": "proceed", "timeout": 1}},
   {"op": "start", "now": 14.6},
   {"op": "finish", "now": 15.6, "outcome": {"kind": "success"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 15.9, "expect": {"kind": "budgetExhausted"}}
  ]},
  {"name": "requête coupée par le budget : budget épuisé, ni panne ni disjoncteur", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 8, "outcome": {"kind": "budgetCut"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 8.3, "expect": {"kind": "budgetExhausted"}},
   {"op": "state", "expect": {"breakerTrips": 0, "consecutiveFailures": 0, "closedUntil": null}}
  ]},
  {"name": "6 requêtes par tentative, puis une reprise limitée à 2", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 0.1, "outcome": {"kind": "success"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 1, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 1},
   {"op": "finish", "now": 1.1, "outcome": {"kind": "success"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 2, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 2},
   {"op": "finish", "now": 2.1, "outcome": {"kind": "success"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 3, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 3},
   {"op": "finish", "now": 3.1, "outcome": {"kind": "success"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 4, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 4},
   {"op": "finish", "now": 4.1, "outcome": {"kind": "success"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 5, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 5},
   {"op": "finish", "now": 5.1, "outcome": {"kind": "success"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 6, "expect": {"kind": "attemptExhausted"}},
   {"op": "beginAttempt", "limit": 2},
   {"op": "admit", "now": 6, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 6},
   {"op": "finish", "now": 6.1, "outcome": {"kind": "notFound"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 7, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 7},
   {"op": "finish", "now": 7.1, "outcome": {"kind": "notFound"}, "expect": {"kind": "proceed"}},
   {"op": "admit", "now": 8, "expect": {"kind": "attemptExhausted"}},
   {"op": "state", "expect": {"attemptRequests": 2}}
  ]},
  {"name": "hors connexion : aucune requête", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "offline", "value": true},
   {"op": "admit", "now": 0, "expect": {"kind": "offline"}},
   {"op": "offline", "value": false},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}}
  ]},
  {"name": "requête annulée (changement de titre) : sans effet", "gate": {}, "steps": [
   {"op": "beginTitle"},
   {"op": "admit", "now": 0, "expect": {"kind": "proceed", "timeout": 8}},
   {"op": "start", "now": 0},
   {"op": "finish", "now": 5, "outcome": {"kind": "cancelled"}, "expect": {"kind": "proceed"}},
   {"op": "state", "expect": {"breakerTrips": 0, "consecutiveFailures": 0, "closedUntil": null}},
   {"op": "admit", "now": 5.3, "expect": {"kind": "proceed", "timeout": 8}}
  ]}
 ]
}
